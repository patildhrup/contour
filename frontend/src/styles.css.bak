@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Manrope:wght@400;500;600;650;700;750;800&family=IBM+Plex+Mono:wght@400;500&display=swap");
@import "tailwindcss";
:root {
  font-family: "DM Sans", sans-serif;
  color: #242724;
  background: #f7f6f2;
  font-synthesis: none;
  font-weight: 400;
  --accent: #ed502f;
  --line: #dedfd7;
  --muted: #686c64;
}
* {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
  scroll-padding-top: 30px;
}
body {
  margin: 0;
}
button,
input,
select {
  font: inherit;
}
button,
a,
input,
select,
summary {
  -webkit-tap-highlight-color: transparent;
}
button,
a,
summary {
  transition:
    background 0.18s,
    color 0.18s,
    transform 0.18s;
}
button {
  cursor: pointer;
}
a {
  color: inherit;
  text-decoration: none;
}
button:disabled {
  cursor: not-allowed;
  opacity: 0.48;
}
button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
summary:focus-visible {
  outline: 3px solid #ef704e;
  outline-offset: 4px;
}
button {
  border: 0;
  background: none;
}
h1,
h2,
h3,
p {
  margin: 0;
}
h1,
h2,
h3 {
  font-family: "Manrope", sans-serif;
}
svg {
  flex-shrink: 0;
}
.wrap {
  width: min(1240px, calc(100% - 96px));
  margin-inline: auto;
}
.nav-shell {
  border-bottom: 1px solid var(--line);
}
.navbar {
  height: 92px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand {
  display: flex;
  align-items: center;
  gap: 9px;
  font-family: "Manrope", sans-serif;
  font-weight: 800;
  font-size: 27px;
  letter-spacing: -1.4px;
}
.brand-mark {
  border: 2px solid var(--accent);
  width: 27px;
  height: 30px;
  color: var(--accent);
  display: grid;
  place-items: center;
  font-size: 30px;
  line-height: 1;
  border-radius: 12px 2px 2px 12px;
  padding-bottom: 5px;
  transform: rotate(-8deg);
}
.brand-dot {
  font-family: inherit;
  font-size: 12px;
  align-self: flex-start;
  margin-top: 3px;
  letter-spacing: 0;
}
.nav-links {
  display: flex;
  gap: 34px;
  font-size: 13px;
  font-weight: 500;
}
.nav-links a:hover {
  color: var(--accent);
}
.nav-start {
  display: flex;
  align-items: center;
  gap: 22px;
  font-size: 13px;
  border: 1px solid #cfd2c8;
  padding: 12px 17px;
  border-radius: 5px;
}
.nav-start:hover {
  background: #ecece5;
}
.hero {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 50px;
  align-items: center;
  padding-block: 72px 66px;
}
.eyebrow {
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: 1.35px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 500;
}
.live-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  background: var(--accent);
  border-radius: 50%;
  flex-shrink: 0;
}
h1 {
  font-size: clamp(40px, 4.6vw, 67px);
  line-height: 1.1;
  letter-spacing: -3.7px;
  font-weight: 650;
  margin-top: 24px;
}
h1 em {
  font-style: normal;
  color: var(--accent);
}
.period {
  color: var(--accent);
}
.hero-copy > p {
  font-size: 16px;
  line-height: 1.75;
  color: #686b63;
  max-width: 380px;
  margin-top: 24px;
}
.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 17px;
  margin-top: 27px;
  font-size: 10px;
  color: #565b51;
}
.hero-meta span {
  display: flex;
  align-items: center;
  gap: 5px;
}
.hero-meta svg {
  color: #53644c;
}
.hero-art {
  border: 1px solid #d2d5ca;
  background: #e7e9df;
  transform: rotate(2deg);
  border-radius: 8px;
  box-shadow:
    0 12px 0 -6px #eeeee7,
    0 13px 0 -6px #cfd3c7;
  overflow: hidden;
  margin: 8px 8px 0;
}
.art-top,
.art-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 17px 22px;
}
.art-top {
  font:
    9px "IBM Plex Mono",
    monospace;
  letter-spacing: 1px;
  border-bottom: 1px solid #cfd4c6;
}
.art-canvas {
  position: relative;
  margin: 21px;
  background: #efe9dc;
  height: 310px;
  border: 1px solid #d6d1c4;
  overflow: hidden;
}
.art-canvas img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  mix-blend-mode: multiply;
}
.art-cross {
  position: absolute;
  font-size: 18px;
  color: #717768;
  font-family: monospace;
}
.tl {
  top: 9px;
  left: 12px;
}
.br {
  bottom: 32px;
  right: 12px;
}
.art-caption {
  position: absolute;
  bottom: 11px;
  left: 13px;
  right: 13px;
  display: flex;
  justify-content: space-between;
  font:
    8px "IBM Plex Mono",
    monospace;
  letter-spacing: 1px;
}
.art-bottom {
  padding-top: 0;
  font-size: 11px;
}
.mini-pill {
  display: flex;
  gap: 7px;
  align-items: center;
  background: #f6f7f0;
  border: 1px solid #cdd2c4;
  padding: 7px 10px;
  border-radius: 3px;
  font:
    10px "IBM Plex Mono",
    monospace;
}
.workspace {
  padding-top: 32px;
  padding-bottom: 48px;
  border-top: 1px solid var(--line);
}
.section-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24px;
  gap: 20px;
}
h2 {
  font-size: 30px;
  font-weight: 600;
  letter-spacing: -1.25px;
  line-height: 1.3;
}
.section-top h2 {
  margin-top: 11px;
}
.workspace-number {
  font:
    9px "IBM Plex Mono",
    monospace;
  color: #757a6f;
  letter-spacing: 1px;
  padding-bottom: 4px;
}
.dropzone {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  background: #fbfbf7;
  border: 1px dashed #bfc4b7;
  padding: 24px 27px;
  border-radius: 7px 7px 0 0;
  transition: 0.2s;
}
.dropzone.dragging {
  background: #fff0e8;
  border-color: var(--accent);
}
.upload-icon {
  background: #eeefe7;
  border: 1px solid #e0e2d7;
  padding: 13px;
  border-radius: 7px;
  color: #57604c;
}
.drop-copy {
  flex: 1;
  min-width: 180px;
}
.drop-copy strong {
  display: block;
  font-size: 14px;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.drop-copy span {
  display: block;
  font-size: 11px;
  color: var(--muted);
  margin-top: 5px;
}
.button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  border-radius: 5px;
  padding: 13px 19px;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}
.secondary {
  background: #fff;
  border: 1px solid #d2d5cb;
}
.secondary:hover {
  background: #efefe7;
}
.primary {
  background: var(--accent);
  color: white;
  border: 1px solid var(--accent);
}
.primary:hover:not(:disabled) {
  background: #cf4023;
  border-color: #cf4023;
  transform: translateY(-1px);
}
.sample-line {
  width: 100%;
  padding-left: 67px;
  font-size: 11px;
  color: #73786d;
  margin-top: -5px;
}
.sample-line button {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  color: #34392e;
  text-decoration: underline;
  text-underline-offset: 3px;
  margin-left: 5px;
}
.workbench {
  display: grid;
  grid-template-columns: 1fr 250px;
  border: 1px solid var(--line);
  border-top: 0;
  background: #fff;
}
.viewer {
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.viewer-top {
  height: 58px;
  padding: 12px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  border-bottom: 1px solid #e4e6df;
}
.segmented {
  display: flex;
  background: #f0f1eb;
  border: 1px solid #e3e5dc;
  border-radius: 5px;
  padding: 3px;
}
.segmented button {
  font-size: 10px;
  padding: 6px 11px;
  border-radius: 3px;
  color: #757a70;
}
.segmented button[aria-pressed="true"] {
  background: white;
  color: #2b3026;
  box-shadow: 0 1px 3px #00000010;
}
.backgrounds {
  display: flex;
  gap: 7px;
}
.swatch {
  width: 18px;
  height: 18px;
  border: 1px solid #d9ddd1;
  border-radius: 50%;
}
.swatch[aria-pressed="true"] {
  outline: 1px solid #6d7660;
  outline-offset: 3px;
}
.check {
  background-color: #f7f8f4;
  background-image:
    linear-gradient(45deg, #e9ebe3 25%, transparent 25%),
    linear-gradient(-45deg, #e9ebe3 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #e9ebe3 75%),
    linear-gradient(-45deg, transparent 75%, #e9ebe3 75%);
  background-size: 16px 16px;
  background-position:
    0 0,
    0 8px,
    8px -8px,
    -8px 0;
}
.light {
  background: #fff;
}
.dark {
  background: #30352f;
}
.preview-area {
  height: 352px;
  position: relative;
  overflow: hidden;
  cursor: grab;
  touch-action: none;
  flex: 1;
  min-height: 350px;
}
.preview-area:active {
  cursor: grabbing;
}
.preview-area.side {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.preview-half {
  position: relative;
  min-width: 0;
  overflow: hidden;
}
.preview-half + .preview-half {
  border-left: 1px solid #d5dacf;
}
.preview-tag {
  position: absolute;
  z-index: 2;
  top: 15px;
  left: 15px;
  font:
    8px "IBM Plex Mono",
    monospace;
  letter-spacing: 1px;
  background: #fffffff0;
  border: 1px solid #e2e5da;
  padding: 6px 8px;
  border-radius: 3px;
  color: #555e4b;
}
.image-stage {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 45px 25px;
}
.image-stage img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  user-select: none;
  transform-origin: center;
  pointer-events: none;
}
.awaiting {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  flex-direction: column;
  gap: 11px;
  color: #6f7962;
  padding: 20px;
}
.awaiting strong {
  font-family: Manrope, sans-serif;
  font-size: 17px;
  font-weight: 600;
  color: #505b45;
}
.awaiting span {
  font-size: 11px;
  max-width: 170px;
  line-height: 1.7;
}
.dark .awaiting,
.dark .awaiting strong {
  color: #e9eddf;
}
.viewer-bottom {
  padding: 12px 17px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #e3e5dd;
  background: #fff;
  gap: 5px;
}
.viewer-bottom > span {
  font-size: 10px;
  color: #747b6d;
  display: flex;
  align-items: center;
  gap: 5px;
}
.zoom-controls {
  display: flex;
  align-items: center;
  gap: 7px;
}
.zoom-controls button {
  padding: 3px;
  color: #626b56;
  display: flex;
}
.zoom-controls button:hover {
  background: #eeeee8;
}
.zoom-controls output {
  font:
    10px "IBM Plex Mono",
    monospace;
  min-width: 37px;
  text-align: center;
}
.zoom-controls i {
  height: 15px;
  width: 1px;
  background: #e0e3d8;
  margin-inline: 3px;
}
.slider-stage,
.slider-overlay {
  position: absolute;
  inset: 0;
}
.slider-stage .image-stage {
  padding: 35px;
}
.slider-overlay {
  pointer-events: none;
}
.divider {
  position: absolute;
  top: 0;
  bottom: 0;
  border-left: 2px solid var(--accent);
  pointer-events: none;
}
.divider span {
  position: absolute;
  top: 50%;
  left: -15px;
  background: var(--accent);
  color: #fff;
  border-radius: 50%;
  width: 28px;
  height: 28px;
  text-align: center;
  line-height: 28px;
}
.compare-range {
  position: absolute;
  inset: auto 15px 15px;
  width: calc(100% - 30px);
  accent-color: var(--accent);
  z-index: 3;
}
.right-tag {
  left: auto;
  right: 15px;
}
.slider-empty {
  position: absolute;
  inset: 45% 15% auto;
  background: #ffffffec;
  border-radius: 3px;
  text-align: center;
  padding: 8px;
  font-size: 11px;
}
.settings {
  padding: 20px;
  border-left: 1px solid var(--line);
  background: #fdfdfa;
}
.settings-title {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 23px;
}
.settings h3 {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: -0.2px;
}
fieldset {
  border: 0;
  padding: 0;
  margin: 0;
}
.setting-label {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  font-weight: 500;
  margin: 16px 0 8px;
}
.setting-label:first-child {
  margin-top: 0;
}
.setting-label span {
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  color: #747c69;
}
.settings select {
  width: 100%;
  padding: 8px 9px;
  border: 1px solid #dadfd0;
  border-radius: 4px;
  background: #fff;
  font-size: 11px;
  color: #434c38;
}
.settings input[type="range"] {
  width: 100%;
  height: 4px;
  accent-color: var(--accent);
  display: block;
  margin: 12px 0 18px;
}
.checkbox-label {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  font-size: 10px;
  line-height: 1.5;
  margin-top: 22px;
}
.checkbox-label input {
  accent-color: var(--accent);
  margin: 1px 0 0;
}
.setting-help {
  font-size: 9px;
  line-height: 1.6;
  color: #7a8171;
  margin: 8px 0 18px;
}
.text-button {
  display: inline-flex;
  gap: 6px;
  align-items: center;
  font-size: 10px;
  color: #626c55;
}
.text-button:hover {
  text-decoration: underline;
}
.conversion-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  background: #fff;
  border: 1px solid var(--line);
  border-top: 0;
  padding: 18px 22px;
  border-radius: 0 0 7px 7px;
}
.conversion-row p {
  font-size: 11px;
  color: #6f7766;
  display: flex;
  align-items: center;
  gap: 8px;
}
.convert {
  min-width: 205px;
}
.download-empty {
  display: flex;
  justify-content: center;
  gap: 6px;
  color: #777f6c;
  font-size: 10px;
  margin-top: 20px;
}
.download-panel {
  background: #eaf0e2;
  border: 1px solid #d7e1cb;
  border-radius: 6px;
  margin-top: 20px;
  padding: 18px 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}
.download-panel strong {
  font-size: 13px;
  display: flex;
  gap: 6px;
  align-items: center;
}
.download-panel p {
  font-size: 10px;
  margin-top: 6px;
  color: #627153;
}
.download-actions {
  display: flex;
  gap: 22px;
  align-items: center;
}
.download-actions .text-button span {
  color: #727c67;
}
.progress {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  padding: 15px;
  background: #fff2e9;
  margin-top: 15px;
  border-radius: 4px;
}
.progress span:last-child {
  margin-left: auto;
}
.spin {
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.cancel {
  font-size: 11px;
  text-decoration: underline;
  margin-top: 10px;
}
.error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: #fff0eb;
  color: #a33019;
  border: 1px solid #e9baac;
  padding: 14px;
  border-radius: 4px;
  font-size: 12px;
  margin-top: 16px;
}
.error button {
  display: flex;
}
.warning {
  font-size: 11px;
  line-height: 1.5;
  color: #8c6026;
  padding: 10px 15px;
  background: #fff8e9;
  margin-top: 10px;
}
.benefits {
  background: #e9ece2;
  border-block: 1px solid #dadecf;
  margin-top: 35px;
  padding: 67px 0;
}
.benefits-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 75px;
}
.benefits h2 {
  font-size: 38px;
  line-height: 1.3;
  margin-top: 19px;
  letter-spacing: -1.8px;
}
.benefits em {
  font-style: normal;
  color: #707d61;
}
.benefit-list article {
  display: flex;
  gap: 22px;
  padding: 23px 0;
  border-bottom: 1px solid #ced5c3;
}
.benefit-list article:first-child {
  padding-top: 0;
}
.benefit-list article:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}
.benefit-list article > span {
  font:
    9px "IBM Plex Mono",
    monospace;
  color: #707b63;
  padding-top: 4px;
}
.benefit-list article svg {
  margin-left: auto;
  color: #77816b;
}
.benefit-list h3 {
  font-size: 15px;
  font-weight: 600;
}
.benefit-list p {
  font-size: 12px;
  line-height: 1.8;
  margin-top: 7px;
  color: #6a745e;
  max-width: 320px;
}
.how {
  padding-block: 75px;
}
.section-top > p {
  font-size: 12px;
  color: var(--muted);
}
.steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 36px;
}
.steps article {
  padding: 10px 34px 10px 0;
}
.steps article + article {
  border-left: 1px solid var(--line);
  padding-left: 34px;
}
.steps article:last-child {
  padding-right: 0;
}
.steps article > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #777f6d;
  margin-bottom: 24px;
}
.steps article > div > span {
  font:
    10px "IBM Plex Mono",
    monospace;
}
.steps h3 {
  font-size: 19px;
  font-weight: 600;
  letter-spacing: -0.5px;
}
.steps p {
  font-size: 12px;
  line-height: 1.8;
  color: var(--muted);
  margin-top: 11px;
  max-width: 300px;
}
.formats {
  border-block: 1px solid var(--line);
  padding-block: 42px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 22px;
}
.formats h2 {
  font-size: 25px;
  margin-top: 12px;
}
.formats p {
  font-size: 11px;
  color: var(--muted);
  margin-top: 12px;
}
.format-flow {
  display: flex;
  align-items: center;
  gap: 9px;
}
.format-flow > span {
  font:
    10px "IBM Plex Mono",
    monospace;
  border: 1px solid #d6dbcb;
  border-radius: 4px;
  padding: 11px 12px;
  background: #fff;
}
.format-flow > svg {
  margin: 0 7px;
  color: #919985;
}
.format-flow strong {
  font:
    13px "IBM Plex Mono",
    monospace;
  background: #e9eddf;
  border: 1px solid #cfd7bf;
  border-radius: 4px;
  padding: 13px 17px;
  display: flex;
  gap: 14px;
}
.formats .format-note {
  width: 100%;
  max-width: 660px;
  line-height: 1.7;
  font-size: 10px;
  margin-top: 0;
}
.pricing {
  padding-block: 45px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;
  border-bottom: 1px solid var(--line);
}
.pricing h2 {
  font-size: 24px;
  margin-top: 12px;
}
.pricing p {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.8;
  max-width: 580px;
  margin-top: 10px;
}
.faq {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 70px;
  padding-block: 70px 80px;
}
.faq h2 {
  font-size: 37px;
  letter-spacing: -1.5px;
  margin-top: 17px;
}
.faq > div > p {
  color: var(--muted);
  font-size: 12px;
  margin-top: 15px;
}
.faq details {
  border-bottom: 1px solid var(--line);
  padding: 19px 0;
}
.faq details:first-child {
  padding-top: 0;
}
.faq summary {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 13px;
  cursor: pointer;
  gap: 20px;
}
.faq summary::-webkit-details-marker {
  display: none;
}
.faq details[open] summary svg {
  transform: rotate(45deg);
}
.faq details p {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.8;
  margin-top: 13px;
  padding-right: 25px;
}
footer {
  display: flex;
  align-items: center;
  gap: 27px;
  padding-block: 28px;
  border-top: 1px solid var(--line);
}
footer .brand {
  font-size: 23px;
}
footer .brand-mark {
  transform: scale(0.8) rotate(-8deg);
  margin-right: -4px;
}
footer p,
footer > span {
  font-size: 10px;
  color: #777d70;
}
footer > div {
  display: flex;
  gap: 20px;
  margin-left: auto;
}
footer button {
  font-size: 11px;
  color: #646d58;
}
footer button:hover {
  color: var(--accent);
}
dialog {
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 37px;
  max-width: 520px;
  width: calc(100% - 32px);
  background: #fafaf6;
  color: #252b20;
}
dialog::backdrop {
  background: #1f291c85;
  backdrop-filter: blur(3px);
}
dialog h2 {
  margin-top: 14px;
}
dialog p {
  font-size: 14px;
  line-height: 1.8;
  color: var(--muted);
  margin: 18px 0 25px;
}
.dialog-close {
  position: absolute;
  right: 15px;
  top: 15px;
  color: #6e7762;
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
@media (min-width: 1500px) {
  .hero {
    padding-block: 85px;
  }
  h1 {
    font-size: 70px;
  }
  .art-canvas {
    height: 340px;
  }
}
@media (max-width: 1050px) {
  .wrap {
    width: calc(100% - 56px);
  }
  .hero {
    gap: 35px;
  }
  h1 {
    font-size: 51px;
    letter-spacing: -2.8px;
  }
  .art-canvas {
    height: 275px;
  }
  .hero-meta {
    gap: 10px;
    font-size: 9px;
  }
  .nav-links {
    gap: 22px;
  }
  .workbench {
    grid-template-columns: 1fr 220px;
  }
  .settings {
    padding: 17px;
  }
  .image-stage {
    padding: 45px 15px;
  }
  .benefits-inner {
    gap: 40px;
  }
  .benefits h2 {
    font-size: 32px;
  }
  .format-flow {
    gap: 7px;
  }
  .formats {
    align-items: flex-start;
  }
  .workspace-number {
    display: none;
  }
}
@media (max-width: 760px) {
  .wrap {
    width: calc(100% - 36px);
  }
  .navbar {
    height: 73px;
  }
  .brand {
    font-size: 24px;
  }
  .nav-links {
    display: none;
  }
  .nav-start {
    font-size: 11px;
    padding: 10px 12px;
    gap: 13px;
  }
  .hero {
    grid-template-columns: 1fr;
    padding-block: 40px;
    gap: 35px;
  }
  .eyebrow {
    font-size: 9px;
    letter-spacing: 1px;
  }
  h1 {
    font-size: clamp(42px, 9.6vw, 68px);
    letter-spacing: -2.8px;
    line-height: 1.1;
    margin-top: 22px;
  }
  .hero-copy > p {
    font-size: 14px;
    max-width: 340px;
    margin-top: 20px;
  }
  .hero-meta {
    font-size: 10px;
    gap: 14px;
    margin-top: 22px;
  }
  .hero-art {
    max-width: 420px;
    width: calc(100% - 10px);
    justify-self: center;
    margin-top: 7px;
  }
  .art-canvas {
    height: 265px;
  }
  .art-top {
    padding: 14px 17px;
  }
  .art-bottom {
    padding-inline: 17px;
  }
  .workspace {
    padding-top: 25px;
  }
  .section-top {
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .section-top h2 {
    font-size: 25px;
  }
  .dropzone {
    padding: 20px 16px;
    gap: 12px;
  }
  .upload-icon {
    padding: 10px;
  }
  .drop-copy {
    min-width: 180px;
  }
  .drop-copy strong {
    font-size: 13px;
  }
  .drop-copy span {
    font-size: 10px;
  }
  .dropzone .secondary {
    margin-left: 54px;
    font-size: 11px;
    padding: 10px 14px;
  }
  .sample-line {
    padding-left: 0;
    font-size: 10px;
    margin-top: 3px;
  }
  .sample-line button {
    font-size: 10px;
  }
  .workbench {
    grid-template-columns: 1fr;
  }
  .settings {
    border-left: 0;
    border-top: 1px solid var(--line);
    padding: 20px;
  }
  .settings-title {
    margin-bottom: 18px;
  }
  .settings fieldset {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 18px;
    align-items: center;
  }
  .setting-label,
  .setting-label:first-child {
    margin: 8px 0;
    font-size: 11px;
  }
  .settings select {
    font-size: 11px;
  }
  .settings input[type="range"] {
    margin: 12px 0;
  }
  .checkbox-label {
    grid-column: 1/-1;
    margin-top: 17px;
    font-size: 11px;
  }
  .setting-help {
    grid-column: 1/-1;
    margin-block: 3px 12px;
    font-size: 10px;
  }
  .preview-area {
    min-height: 300px;
    height: 300px;
    flex: auto;
  }
  .awaiting strong {
    font-size: 14px;
  }
  .awaiting span {
    font-size: 10px;
  }
  .preview-tag {
    font-size: 7px;
    left: 9px;
    top: 12px;
    letter-spacing: 0.5px;
    padding: 5px;
  }
  .viewer-top {
    padding-inline: 12px;
  }
  .image-stage {
    padding: 48px 12px;
  }
  .conversion-row {
    flex-direction: column;
    align-items: stretch;
    padding: 17px;
    gap: 14px;
  }
  .conversion-row p {
    font-size: 10px;
    line-height: 1.5;
  }
  .convert {
    width: 100%;
  }
  .download-empty {
    font-size: 9px;
  }
  .download-panel {
    padding: 16px;
    gap: 16px;
  }
  .download-actions {
    width: 100%;
    justify-content: space-between;
  }
  .benefits {
    padding-block: 42px;
    margin-top: 10px;
  }
  .benefits-inner {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .benefits h2 {
    font-size: 33px;
  }
  .benefit-list article {
    gap: 18px;
  }
  .how {
    padding-block: 44px;
  }
  .how .section-top {
    display: block;
  }
  .section-top > p {
    margin-top: 12px;
    font-size: 11px;
  }
  .steps {
    grid-template-columns: 1fr;
    margin-top: 25px;
  }
  .steps article,
  .steps article + article,
  .steps article:last-child {
    padding: 23px 0;
    border-left: 0;
    border-top: 1px solid var(--line);
  }
  .steps article > div {
    margin-bottom: 12px;
  }
  .steps p {
    max-width: 100%;
    font-size: 12px;
  }
  .formats {
    padding-block: 32px;
    gap: 22px;
  }
  .formats h2 {
    font-size: 24px;
  }
  .formats p {
    line-height: 1.8;
  }
  .format-flow {
    gap: 6px;
    flex-wrap: wrap;
  }
  .format-flow > span {
    padding: 10px;
  }
  .format-flow strong {
    padding: 12px;
  }
  .pricing {
    flex-direction: column;
    align-items: flex-start;
    padding-block: 32px;
    gap: 22px;
  }
  .pricing h2 {
    font-size: 25px;
  }
  .faq {
    grid-template-columns: 1fr;
    gap: 32px;
    padding-block: 44px;
  }
  .faq h2 {
    font-size: 32px;
  }
  .faq h2 br {
    display: none;
  }
  .faq summary {
    font-size: 12px;
  }
  footer {
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 23px;
  }
  footer p {
    margin-left: auto;
  }
  footer > div {
    margin: 0;
    gap: 20px;
  }
  footer > span {
    margin-left: auto;
  }
  .right-tag {
    left: auto;
    right: 9px;
  }
  .slider-stage .image-stage {
    padding: 40px;
  }
  .progress {
    font-size: 11px;
    line-height: 1.5;
  }
}
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
}

.art-canvas .demo-original {
  image-rendering: pixelated;
}
.demo-vector {
  position: absolute;
  inset: 0;
  clip-path: inset(0 0 0 50%);
  background: #efe9dc;
}
.demo-vector img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.demo-seam {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  border-left: 1px solid #b8baaa;
}
.demo-seam span {
  position: absolute;
  top: 50%;
  left: -12px;
  border-radius: 50%;
  background: #f8f8f2;
  width: 23px;
  height: 23px;
  display: grid;
  place-items: center;
  font-size: 13px;
  border: 1px solid #c5cabb;
}
.demo-labels {
  position: absolute;
  top: 13px;
  left: 34px;
  right: 17px;
  display: flex;
  justify-content: space-between;
  font:
    8px "IBM Plex Mono",
    monospace;
  letter-spacing: 1px;
  color: #545e47;
}
.preview-area:focus-visible {
  outline: 3px solid #ef704e;
  outline-offset: -3px;
}
