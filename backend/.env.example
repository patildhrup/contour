# Backend: copy to .env in project root. Run uvicorn from this directory.
MAX_UPLOAD_BYTES=10485760
MAX_PIXELS=4000000
MAX_DIMENSION=4096
CONVERSION_TIMEOUT=60
MAX_CONCURRENT=2
MAX_SVG_BYTES=20971520
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional external AI vectorizer: a Hugging Face Gradio Space (ZeroGPU needs
# the gradio SDK). Leave unset to have the 'ai' engine fall back to the classic
# tracer. Use the Space's API host, NOT the huggingface.co/spaces webpage.
# The backend appends Gradio's REST path (/gradio_api/call/vectorize) itself.
# AI_ENGINE_URL=https://<owner>-<space>.hf.space
# A READ-scoped HF token makes ZeroGPU quota count for your account and lifts
# public-space rate limits; omit it for a plain public Space.
# AI_ENGINE_TOKEN=

# Frontend: optionally set in frontend/.env; empty uses same-origin /api.
# VITE_API_BASE_URL=
